# Dockerfile for Philotes Dagster Proxy
# Build stage
FROM golang:1.26-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /philotes-dagster-proxy \
    ./cmd/philotes-dagster-proxy

# Runtime stage
FROM alpine:3.23

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata wget

# Create non-root user
RUN addgroup -g 1000 philotes && \
    adduser -u 1000 -G philotes -s /bin/sh -D philotes

# Copy binary from builder
COPY --from=builder /philotes-dagster-proxy /usr/local/bin/philotes-dagster-proxy

# Set ownership
RUN chown philotes:philotes /usr/local/bin/philotes-dagster-proxy

# Switch to non-root user
USER philotes

# Expose proxy port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:8080/health || exit 1

# Run the proxy
ENTRYPOINT ["/usr/local/bin/philotes-dagster-proxy"]
