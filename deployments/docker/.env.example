# Philotes Local Development Environment Variables

# PostgreSQL Buffer Database
POSTGRES_USER=philotes
POSTGRES_PASSWORD=philotes
POSTGRES_DB=philotes

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Storage (MinIO/S3)
# PHILOTES_STORAGE_ENDPOINT=localhost:9000               # API-facing (host)
# PHILOTES_STORAGE_DOCKER_ENDPOINT=http://minio:9000     # Docker-internal (Lakekeeper)
# PHILOTES_STORAGE_REGION=us-east-1

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
